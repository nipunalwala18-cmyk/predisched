# Benchmark and campaign traces are checksummed byte for byte (workloads/benchmark/manifest.txt):
# keep them LF on every platform, whatever core.autocrlf says.
*.jsonl text eol=lf
workloads/benchmark/manifest.txt text eol=lf
workloads/benchmark/exec-samples.csv text eol=lf
# Shell scripts run in Linux containers and CI (prompt 24): LF even from a Windows checkout.
*.sh text eol=lf
docker/nginx.conf text eol=lf
